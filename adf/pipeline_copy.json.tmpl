
[
    {
      "name": "${activity_name}",
      "type": "Copy",
      "dependsOn": [],
      "policy": {
        "timeout": "7.00:00:00",
        "retry": 1,
        "retryIntervalInSeconds": 30,
        "secureOutput": false,
        "secureInput": false
      },
      "typeProperties": {
        "source": {
          "type": "SqlSource",
          "sqlReaderQuery": "SELECT * FROM ${sql_table}"
        },
        "sink": {
          "type": "DelimitedTextSink"
        }
      },
      "inputs": [
        {
          "referenceName": "${input_dataset}",
          "type": "DatasetReference"
        }
      ],
      "outputs": [
        {
          "referenceName": "${output_dataset}",
          "type": "DatasetReference"
        }
      ]
    }
  ]
  