{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "dataFactoryName": {
      "type": "string"
    },
    "adlsLinkedServiceName": {
  "type": "string"
},
"datasetName": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.DataFactory/factories/datasets",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('dataFactoryName'), '/', parameters('datasetName'))]",

      "properties": {
        "linkedServiceName": {
           "referenceName": "[parameters('adlsLinkedServiceName')]",
           "type": "LinkedServiceReference"
        },
        "type": "DelimitedText",
        "typeProperties": {
          "location": {
            "type": "AzureBlobStorageLocation",
            "fileName": {
              "value": "ventes_@{formatDateTime(pipeline().TriggerTime, 'yyyyMMdd')}.csv",
              "type": "Expression"
            },
            "folderPath": "orders",
            "container": "landing"
          },
          "escapeChar": "\\",
          "quoteChar": "\"",
          "firstRowAsHeader": true
        },
        "schema": []
      }
    }
  ]
}
